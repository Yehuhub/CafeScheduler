generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums are stored as strings in SQLite (Prisma 5+ doesn't support native SQLite enums).
// TypeScript union types in shared/types.ts carry the type safety at the application layer.

model User {
  id                   Int      @id @default(autoincrement())
  name                 String
  username             String   @unique
  passwordHash         String
  role                 String   // Role: "boss" | "employee"
  isCook               Boolean
  isBarista            Boolean
  defaultShiftsPerWeek Int
  isActive             Boolean  @default(true)
  isDeleted            Boolean  @default(false)
  createdAt            DateTime @default(now())

  availability      Availability[]
  weeklyShiftCounts WeeklyShiftCount[]
  assignments       Assignment[]
}

model Week {
  id          Int       @id @default(autoincrement())
  startDate   DateTime  @unique
  status      String    @default("availability_open") // WeekStatus
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  availability      Availability[]
  shiftRequirements ShiftRequirement[]
  weeklyShiftCounts WeeklyShiftCount[]
  assignments       Assignment[]
  shifts            Shift[]
}

// A named, boss-defined shift within a week (e.g. "Morning" 06:00, "Mid Evening" 15:00).
// Replaces the old fixed slot enum. Deleting a shift cascades to its requirements,
// availability, and assignments — the intended behavior when the boss removes a shift.
model Shift {
  id        Int    @id @default(autoincrement())
  weekId    Int
  name      String
  startTime String // "HH:MM"

  week             Week               @relation(fields: [weekId], references: [id])
  requirements     ShiftRequirement[]
  availability     Availability[]
  assignments      Assignment[]

  @@unique([weekId, name])
}

model Availability {
  id        Int     @id @default(autoincrement())
  weekId    Int
  userId    Int
  day       Int     // 0–6, Sunday = 0
  shiftId   Int
  available Boolean

  week  Week  @relation(fields: [weekId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([weekId, userId, day, shiftId])
}

model ShiftRequirement {
  id             Int    @id @default(autoincrement())
  weekId         Int
  day            Int
  shiftId        Int
  cooksNeeded    Int
  baristasNeeded Int

  week  Week  @relation(fields: [weekId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([weekId, day, shiftId])
}

model WeeklyShiftCount {
  id             Int @id @default(autoincrement())
  weekId         Int
  userId         Int
  shiftsThisWeek Int

  week Week @relation(fields: [weekId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([weekId, userId])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  weekId      Int
  userId      Int
  day         Int
  shiftId     Int
  roleWorking String   // RoleWorking: "cook" | "barista"
  createdAt   DateTime @default(now())

  week  Week  @relation(fields: [weekId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}
